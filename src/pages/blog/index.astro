---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="Journal"
  description="Notes on thoughtful design, useful websites, and making good things."
>
  <section class="container section">
    <p class="eyebrow">The journal</p>
    <h1 class="page-title">
      A few things
      <br />
      on our minds.
    </h1>
    <p class="lead">
      Notes from the space between strategy, design, and making things work.
    </p>
  </section>
  <section class="container pb-24 grid md:grid-cols-3 gap-7">
    {posts.map((post, i) => (
      <article class="group">
        <a href={`/blog/${post.id}/`} class="block">
          <div
            class:list={[
              "rounded-2xl aspect-[4/3] mb-7 flex items-center justify-center overflow-hidden",
              i === 0 ? "bg-[#e5e9df]" : i === 1 ? "bg-accent" : "bg-ink",
            ]}
            aria-hidden="true"
          >
            <span
              class:list={[
                "text-[8rem] font-serif group-hover:rotate-12 transition-transform",
                i === 2 ? "text-paper" : "text-ink",
              ]}
            >
              {["✳", "↗", "◒"][i % 3]}
            </span>
          </div>
          <div class="eyebrow muted flex justify-between">
            <span>{post.data.category}</span>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                timeZone: "UTC",
              })}
            </time>
          </div>
          <h2 class="text-2xl tracking-tight mt-4 mb-3 group-hover:underline">
            {post.data.title}
          </h2>
          <p class="muted leading-relaxed">{post.data.description}</p>
          <span class="inline-block mt-5 text-sm underline">
            Read the story ↗
          </span>
        </a>
      </article>
    ))}
  </section>
</Layout>
