---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" noindex>
  <section class="container section min-h-[60vh]">
    <p class="eyebrow">404 · A little off the beaten path</p>
    <h1 class="page-title">
      This page took
      <br />a different turn.
    </h1>
    <p class="lead">
      The page you’re looking for may have moved, or the link might be
      incorrect.
    </p>
    <a class="button mt-8" href="/">
      Back to the good stuff ↗
    </a>
  </section>
</Layout>
