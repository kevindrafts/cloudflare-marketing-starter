---
import { services } from "../data/site";
---

<div>
  {services.map((service) => (
    <article class="grid md:grid-cols-[70px_1fr_1fr] gap-5 py-9 border-t border-line">
      <span class="eyebrow muted">/{service.number}</span>
      <h3 class="text-2xl md:text-3xl tracking-tight">{service.title}</h3>
      <div>
        <p class="muted leading-relaxed">{service.text}</p>
        <p class="text-xs mt-5 font-medium">{service.tags}</p>
      </div>
    </article>
  ))}
</div>
